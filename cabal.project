-- shikumi build descriptor.
--
-- shikumi depends on four packages from the baikai repository: `baikai`
-- (core transport), the provider packages `baikai-claude` / `baikai-openai`,
-- and `baikai-effectful` (the thin, policy-free `effectful` binding over
-- baikai's transport). They are pinned to a GitHub commit so fresh clones build
-- reproducibly without local sibling checkouts.
--
-- The GHC toolchain (9.12.4) + cabal come from the dev shell defined in
-- ./flake.nix (`nix develop`), shared via the `shinzui/haskell-nix-dev` base
-- flake. The system PATH ghc (9.10.3) is the WRONG compiler; build inside the
-- dev shell.
packages:
  shikumi
  shikumi-cache
  shikumi-cache-redis
  shikumi-cache-postgres
  shikumi-cli
  shikumi-compile
  shikumi-eval
  shikumi-jitsurei
  shikumi-optimize
  shikumi-tools
  shikumi-trace
  shikumi-trace-otel

source-repository-package
  type: git
  location: https://github.com/shinzui/baikai.git
  tag: f17f83fa8668bc5f3166cac94b7c0f11f1199d1a
  subdir:
    baikai
    baikai-claude
    baikai-openai
    baikai-effectful

-- blake3 (EP-6 cache key) vendors SIMD C/asm. Its non-x86 fallback for the SSE
-- flags still compiles x86 intrinsics (mmintrin.h), which fails under clang on
-- aarch64-darwin. Disable the SIMD flags so only the portable pure-C path
-- (cbits/blake3_portable.c) is built. The portable hash is byte-identical to the
-- SIMD path, so the content-addressed key (integration point #7) is unaffected.
package blake3
  flags: -avx512 -avx2 -sse41 -sse2
  -- The package's cabal also never compiles blake3_neon.c nor disables NEON on
  -- aarch64, so blake3_dispatch.c references an undefined blake3_hash_many_neon.
  -- Define BLAKE3_USE_NEON=0 so dispatch uses the portable path on ARM.
  ghc-options: -optc-DBLAKE3_USE_NEON=0

-- hasql (EP-6 Postgres backend) depends on postgresql-libpq, which by default
-- shells out to `pg_config` to find libpq. The pinned nixpkgs ships libpq's
-- pkg-config file (libpq.pc) but no standalone `pg_config` binary, so build it
-- against pkg-config instead.
package postgresql-libpq
  flags: +use-pkg-config

test-show-details: direct
tests: True

-- Parallel module compilation
jobs: $ncpus
