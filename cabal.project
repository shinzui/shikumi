-- shikumi build descriptor.
--
-- shikumi depends on the published baikai packages: `baikai` (core
-- transport), the provider packages `baikai-claude` / `baikai-openai`, and
-- `baikai-effectful` (the thin, policy-free `effectful` binding over baikai's
-- transport). Cabal resolves these from Hackage like the rest of the package
-- set.
--
-- The GHC toolchain (9.12.4) + cabal come from the dev shell defined in
-- ./flake.nix (`nix develop`), shared via the `shinzui/haskell-nix-dev` base
-- flake. The system PATH ghc (9.10.3) is the WRONG compiler; build inside the
-- dev shell.
packages:
  shikumi
  shikumi-cache
  shikumi-cache-redis
  shikumi-cache-postgres
  shikumi-cli
  shikumi-compile
  shikumi-eval
  shikumi-jitsurei
  shikumi-okf
  shikumi-optimize
  shikumi-tools
  shikumi-trace
  shikumi-trace-otel

-- shikumi-okf (EP-31) documents shikumi programs as OKF bundles and therefore
-- depends on the published `okf-core` library. This keeps okf-core OUT of every
-- other package's build plan: only shikumi-okf lists it under build-depends, so
-- `cabal build shikumi` (core) never compiles it.

-- cmark-gfm fork: makes core-extension registration thread-safe, so parsing
-- Markdown from more than one thread does not abort the process.
--
-- okf-core reaches cmark-gfm on every bundle read. Upstream's
-- `ensurePluginsRegistered` calls straight through to a C function that guards
-- itself with a plain non-atomic check-then-set, so two threads can both
-- register the core extensions; the second registration calls
-- `cmark_register_node_flag` on an already-initialised global, which prints
-- "flag initialization error in cmark_register_node_flag" and abort()s. The
-- symptom is SIGABRT, not a catchable exception -- shikumi-okf's suite died at
-- exit code 134 with an empty log until this pin landed. Measured on a
-- 16-thread reproducer: stock aborted 7/20 runs, the fork 0/20.
--
-- The full mechanism is recorded upstream-side at
-- mori://kivikakk/cmark-gfm-hs, entry
-- `cmark-gfm-hs-unsafe-concurrent-extension-registration`.
--
-- Note this pin governs builds *of this repository only*. A package that
-- depends on shikumi-okf from Hackage does not inherit it and must add the same
-- stanza, or it keeps the abort. That is why shikumi-okf's test suite also
-- warms up registration on its main thread: the warm-up is what protects a
-- consumer building without this stanza, and it is not redundant with it.
--
-- Pinned by commit, never by branch, so the resolution is reproducible. Remove
-- this stanza to fall back to Hackage cmark-gfm 0.2.6 exactly -- which is the
-- newest release, so there is no fixed version to move to instead.
source-repository-package
  type: git
  location: https://github.com/shinzui/cmark-gfm-hs.git
  tag: a9014e8c4974d636e7c8f85cd97812905d217faf

-- blake3 (EP-6 cache key) vendors SIMD C/asm. Its non-x86 fallback for the SSE
-- flags still compiles x86 intrinsics (mmintrin.h), which fails under clang on
-- aarch64-darwin. Disable the SIMD flags so only the portable pure-C path
-- (cbits/blake3_portable.c) is built. The portable hash is byte-identical to the
-- SIMD path, so the content-addressed key (integration point #7) is unaffected.
package blake3
  flags: -avx512 -avx2 -sse41 -sse2
  -- The package's cabal also never compiles blake3_neon.c nor disables NEON on
  -- aarch64, so blake3_dispatch.c references an undefined blake3_hash_many_neon.
  -- Define BLAKE3_USE_NEON=0 so dispatch uses the portable path on ARM.
  ghc-options: -optc-DBLAKE3_USE_NEON=0

-- hasql (EP-6 Postgres backend) depends on postgresql-libpq, which by default
-- shells out to `pg_config` to find libpq. The pinned nixpkgs ships libpq's
-- pkg-config file (libpq.pc) but no standalone `pg_config` binary, so build it
-- against pkg-config instead.
package postgresql-libpq
  flags: +use-pkg-config

test-show-details: direct
tests: True

-- Parallel module compilation
jobs: $ncpus
