cabal-version: 3.4
name:          shikumi-cli
version:       0.1.0.0
synopsis:      The shikumi command-line interface (EP-12)
description:
  The user-facing command line for shikumi: a library of reusable subcommand
  builders plus a small bundled example executable named @shikumi@. Because a
  @Program i o@ is a typed Haskell value (not a config file), the CLI is a
  library a user wires around their own typed programs via a tiny @main@ — the
  bundled example is exactly that @main@. Four subcommands surface the framework's
  major capabilities: @eval@ (render a Report over a dataset + metric), @trace@
  (render a recorded hierarchical trace tree), @optimize@ (run an optimizer and
  save the compiled program), and @replay@ (deterministically re-run a stored
  trace). Everything runs offline against a deterministic in-process stub LM, so
  every transcript reproduces from a clean checkout with no API key or network.

license:       BSD-3-Clause
author:        Nadeem Bitar
maintainer:    nadeem@gmail.com
build-type:    Simple

common common-options
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Wredundant-constraints
    -fhide-source-paths -Wmissing-export-lists -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language:   GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

library
  import:          common-options
  hs-source-dirs:  src
  exposed-modules:
    Shikumi.Cli
    Shikumi.Cli.Example
    Shikumi.Cli.Options
    Shikumi.Cli.Registry
    Shikumi.Cli.Run
    Shikumi.Cli.Runtime

  build-depends:
    , aeson
    , baikai                >=0.2  && <0.3
    , base                  >=4.20 && <5
    , bytestring
    , containers
    , directory
    , effectful
    , filepath
    , generic-lens
    , lens                  ^>=5.3
    , optparse-applicative
    , shikumi
    , shikumi-compile
    , shikumi-eval
    , shikumi-optimize
    , shikumi-trace
    , shikumi-trace-otel
    , text                  ^>=2.1
    , vector

executable shikumi
  import:         common-options
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -with-rtsopts=-N
  build-depends:
    , base
    , shikumi-cli

test-suite shikumi-cli-test
  import:         common-options
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded -with-rtsopts=-N
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , shikumi
    , shikumi-cli
    , shikumi-compile
    , shikumi-eval
    , shikumi-optimize
    , shikumi-trace
    , tasty
    , tasty-hunit
    , text
